# quizmaster – Entwicklung
# Anlegen mit:  pnpm setup:env dev   (erzeugt .env.dev mit frischen Secrets, überschreibt nie)
# Danach nur die mit "TODO" markierten Werte eintragen. Die Datei .env.dev wird nie committet.

# ── Ports & Adressen ─────────────────────────────────────────────
# Web (Next.js) und Realtime (Socket.IO) laufen lokal nur auf 127.0.0.1.
QUIZMASTER_PORT=3000
REALTIME_PORT=4000
# Leer = abgeleitet: http://localhost:<QUIZMASTER_PORT> bzw. http://localhost:<REALTIME_PORT>
APP_ORIGIN=
REALTIME_URL=

# ── MongoDB (Replica Set ≥ 8.0) ─────────────────────────────────
# TODO: URI deines Dev-Clusters, z. B. mongodb+srv://user:pass@cluster.example.net/?retryWrites=true&w=majority
# Der User braucht readWrite auf MONGODB_DB und auf TEST_MONGODB_DB.
MONGODB_URI=
MONGODB_DB=quizmaster_dev
# Automatische Tests (Integration/E2E/Lasttest) laufen hier, jeder Lauf mit eigenem Collection-Präfix.
TEST_MONGODB_DB=quizmaster_test
# Optional, nur mit einer *_test-Datenbank in MONGODB_DB (z. B. Admin-Werkzeuge gegen einen Testlauf); Tests setzen
# ihr Präfix je Lauf selbst, in Produktion ist es verboten.
# MONGODB_COLLECTION_PREFIX=

# ── Secrets (werden von setup:env erzeugt, je Umgebung verschieden) ──
SESSION_SECRET=
REALTIME_TICKET_SECRET=
IP_HASH_SECRET=
METRICS_TOKEN=

# ── Bot-Schutz (Cloudflare Turnstile) ────────────────────────────
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Realtime ─────────────────────────────────────────────────────
# Leer lassen, solange der Server nicht ausschließlich über einen Proxy erreichbar ist.
TRUSTED_IP_HEADER=
GAME_TIMING=normal
QUESTION_POOL=all
MAX_CONNECTIONS=20000
DEV_BOTS_ENABLED=true
LOG_LEVEL=info

# ── Optional, nur lokal: lesendes Datenbank-Werkzeug (MongoDB-MCP-Server mit --readOnly, nur Dev) ──
# Keine App und kein Werkzeug dieses Repos liest den Wert. Nur ein User mit read-Rolle auf MONGODB_DB – nie der
# Dev- oder Prod-User mit Schreibrechten.
MDB_MCP_CONNECTION_STRING=

# ── Nur zur Information: Schalter der Prozess-Umgebung ───────────
# Diese Werte liest NICHTS aus dieser Datei – bei Bedarf in der Shell vor dem Befehl setzen.
# TEST_MONGODB_URI=               Tests gegen einen eigenen Cluster (dazu TEST_MONGODB_DB, endet auf _test); ohne:
#                                 MONGODB_URI + TEST_MONGODB_DB von oben, ohne .env.dev ein MongoMemoryReplSet (CI)
# RATE_LIMIT_MODE=normal          relaxed = alle Limits ×100, nur mit *_test-Datenbank (stack:test, loadtest setzen es)
# REALTIME_TEST_PORTS=4130-4139   Port-Bereich der Realtime-Integrationstests (test/core)
# QM_TEST_LOG_LEVEL=silent        Log-Level des Realtime-Test-Servers
# LOADTEST_TICKET_SECRET=         pnpm loadtest --target: Ticket-Secret der Zielinstanz (read -rs, nie in eine Datei)
# LOADTEST_METRICS_TOKEN=         pnpm loadtest --target: METRICS_TOKEN der Zielinstanz (optional, ebenso)
