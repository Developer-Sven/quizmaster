{
  "name": "quizmaster",
  "private": true,
  "description": "Live-Quiz-Duelle für 2–8 Personen als PWA – Web (Next.js) + Realtime (Socket.IO) + MongoDB.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "env:check": "node scripts/env/check.ts",
    "dev": "node scripts/env/run.ts dev -- turbo run dev --concurrency=4",
    "build": "turbo run build --concurrency=2",
    "check": "biome check . && turbo run typecheck --concurrency=2 && pnpm test && pnpm content:validate",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @quizmaster/e2e test",
    "test:smoke": "pnpm --filter e2e test:smoke",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck --concurrency=2",
    "content:validate": "pnpm --filter @quizmaster/scripts content:validate",
    "content:dedupe": "pnpm --filter @quizmaster/scripts content:dedupe",
    "content:digest": "pnpm --filter @quizmaster/scripts content:digest",
    "content:stats": "pnpm --filter @quizmaster/scripts content:stats",
    "content:seed": "pnpm --filter @quizmaster/scripts content:seed",
    "content:ids": "pnpm --filter @quizmaster/scripts content:ids",
    "content:fixtures": "pnpm --filter @quizmaster/scripts content:fixtures",
    "content:calibrate": "node scripts/content/calibrate.ts",
    "stack:test": "node scripts/dev/stack-test.ts",
    "deploy:prod": "node scripts/deploy/deploy.ts deploy",
    "deploy:rollback": "node scripts/deploy/deploy.ts rollback",
    "deploy:restart": "node scripts/deploy/deploy.ts restart",
    "deploy:status": "node scripts/deploy/deploy.ts status",
    "caddy:dry-run": "bash infra/caddy/install-site.sh --dry-run",
    "caddy:install": "bash infra/caddy/install-site.sh",
    "ops:backup": "bash infra/ops/backup.sh",
    "ops:check-backup": "bash infra/ops/check-backup.sh",
    "ops:restore-test": "bash infra/ops/restore-test.sh",
    "ops:healthcheck": "bash infra/ops/healthcheck.sh",
    "ops:alert-test": "bash infra/ops/alert.sh \"Testalarm von quizmaster\"",
    "ops:install-cron": "bash infra/ops/install-cron.sh",
    "ops:create-user": "bash infra/ops/create-user.sh",
    "ops:restore": "bash infra/ops/restore.sh",
    "admin:config": "node scripts/ops/admin.ts config",
    "admin:ban": "node scripts/ops/admin.ts ban",
    "admin:game": "node scripts/ops/admin.ts game",
    "admin:reports": "node scripts/admin/reports.ts",
    "perf:budgets": "node scripts/perf/bundle-budget.ts",
    "perf:lighthouse": "node scripts/perf/lighthouse.ts",
    "loadtest": "node scripts/loadtest/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
