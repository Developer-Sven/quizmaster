# quizmaster – Produktion
# Anlegen mit:  pnpm setup:env prod --domain <domain> --port <port> --tls-cert <pfad> --tls-key <pfad>
# (erzeugt .env.prod mit frischen Secrets, Rechte 600, überschreibt nie)
# Danach nur die mit "TODO" markierten Werte eintragen. Die Datei .env.prod wird nie committet.

# ── Domain & Port ────────────────────────────────────────────────
# Öffentliche Domain (hinter dem Cloudflare-Proxy). Alles Weitere wird daraus abgeleitet.
QUIZMASTER_DOMAIN=quiz.example.com
# Web lauscht auf 127.0.0.1:<QUIZMASTER_PORT>, Realtime auf 127.0.0.1:<REALTIME_PORT> (leer = Port + 1).
QUIZMASTER_PORT=7400
REALTIME_PORT=
# TLS zwischen Cloudflare und diesem Server (Cloudflare-Origin-Zertifikat, SSL-Modus "Full (strict)").
TLS_CERT_FILE=/path/to/origin-cert.pem
TLS_KEY_FILE=/path/to/origin-key.pem
# Optional: überschreibt die abgeleitete Origin https://<QUIZMASTER_DOMAIN>
APP_ORIGIN=
# Leer = gleiche Origin (Pfad /socket.io/* wird an Realtime geroutet).
REALTIME_URL=
# Nur gesetzt, weil der Server für diese Domain ausschließlich über Cloudflare erreichbar ist.
TRUSTED_IP_HEADER=cf-connecting-ip
# Suchmaschinen-Indexierung (privates Projekt: aus)
SEARCH_INDEXING=false

# ── MongoDB (Replica Set ≥ 8.0) ─────────────────────────────────
# TODO: URI deines Prod-Clusters (ohne DB-Pfad; MONGODB_DB bestimmt die Datenbank)
MONGODB_URI=
MONGODB_DB=quizmaster

# ── Secrets (werden von setup:env erzeugt) ───────────────────────
SESSION_SECRET=
REALTIME_TICKET_SECRET=
IP_HASH_SECRET=
METRICS_TOKEN=
# Verschlüsselt die täglichen DB-Backups – zusätzlich im Passwortmanager sichern!
BACKUP_PASSPHRASE=

# ── Bot-Schutz (Cloudflare Turnstile) ────────────────────────────
# TODO: Widget für die Domain anlegen, Keys eintragen, dann TURNSTILE_ENABLED=true
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Realtime ─────────────────────────────────────────────────────
GAME_TIMING=normal
QUESTION_POOL=all
MAX_CONNECTIONS=20000
DEV_BOTS_ENABLED=false
LOG_LEVEL=info

# ── Alarme ───────────────────────────────────────────────────────
# TODO (optional, empfohlen): Webhook-URL (z. B. Discord), an die der Watchdog Alarme schickt
ALERT_WEBHOOK_URL=
