{
  "name": "@quizmaster/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:a11y": "playwright test --project=a11y-360 --project=a11y-430",
    "test:sync": "playwright test --project=sync --no-deps",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@quizmaster/db": "workspace:*",
    "@quizmaster/shared": "workspace:*",
    "jose": "6.2.12",
    "socket.io-client": "4.8.4"
  }
}
